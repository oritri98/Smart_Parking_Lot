# ──────────────────────────────────────────────────────────
# AUST-IPMS Root .gitignore
# ──────────────────────────────────────────────────────────

# ── Node / Frontend ──────────────────────────────────────
node_modules/
jspm_packages/
web_modules/
dist/
dist-ssr/
build/
out/
.next/
.nuxt/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── PHP / Laravel Backend ─────────────────────────────────
/backend/vendor/
/backend/node_modules/
/backend/public/build/
/backend/public/hot/
/backend/public/storage/
/backend/storage/*.key
/backend/storage/pail/
/backend/storage/logs/
/backend/storage/framework/cache/data/
/backend/storage/framework/sessions/
/backend/storage/framework/views/
/backend/bootstrap/cache/*.php

# ── Python / Vision ML Service ────────────────────────────
vision-service/__pycache__/
vision-service/*.py[cod]
vision-service/*.pyo
vision-service/*.pyd
vision-service/.venv/
vision-service/venv/
vision-service/env/
# YOLO / ML model weight files (large binary, download on deploy)
vision-service/*.pt
vision-service/*.weights
vision-service/*.onnx
vision-service/runs/

# ── Secret & Credential Files ──────────────────────────────
# ⚠️ NEVER commit .env files — set these as Railway/CI env vars
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
!.env.example
!**/.env.example
secrets/
credentials/
*.pem
*.key
*.cert
*.crt
id_rsa*
*.pfx
*.p12
RAILWAY_DEPLOYMENT.md
railway_deployment.md

# ── Databases & Cache (never commit live databases) ──────────
*.sqlite
*.sqlite3
*.db
**/*.sqlite*
**/*.db
database/database.sqlite
backend/database/database.sqlite

# ── Logs ──────────────────────────────────────────────────
*.log

# ── OS & IDE Files ─────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/
.phpactor.json
.phpunit.result.cache
/.phpunit.cache/
